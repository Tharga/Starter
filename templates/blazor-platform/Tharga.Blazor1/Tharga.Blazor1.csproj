<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tharga.Team.Blazor" Version="4.8.1" />
    <PackageReference Include="Tharga.Team.Service" Version="4.8.1" />
    <PackageReference Include="Tharga.Team.MongoDB" Version="4.8.1" />
    <!--#if (IncludeMcp) -->
    <PackageReference Include="Tharga.Team.Mcp" Version="4.8.1" />
    <!--#endif -->
    <!--#if (IncludeEntra) -->
    <PackageReference Include="Tharga.Team.Entra" Version="4.8.1" />
    <!--#endif -->
    <PackageReference Include="Tharga.Toolkit.Standard" Version="1.19.0" />
    <PackageReference Include="Tharga.MongoDB.Blazor" Version="2.21.1" />
    <!--#if (IncludeCache) -->
    <PackageReference Include="Tharga.Cache.Blazor" Version="1.2.1" />
    <!--#endif -->
    <!--#if (IncludeHealth) -->
    <PackageReference Include="Quilt4Net.Toolkit.Health" Version="1.0.32" />
    <!--#endif -->
    <!--#if (IncludeQuilt4Net) -->
    <PackageReference Include="Quilt4Net.Toolkit.Api" Version="1.0.32" />
    <PackageReference Include="Quilt4Net.Toolkit.Blazor" Version="1.0.32" />
    <!--#endif -->
    <ProjectReference Include="..\Tharga.Blazor1.Client\Tharga.Blazor1.Client.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.15" />
  </ItemGroup>

  <Target Name="RemoveClientRuntimeConfig" AfterTargets="Publish">
    <Delete Files="$(PublishDir)Tharga.Blazor1.Client.runtimeconfig.json" />
  </Target>

</Project>
