<RadzenHeader>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Stretch" JustifyContent="JustifyContent.SpaceBetween" Gap="0">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
            <RadzenSidebarToggle Click="@(() => _menuExpanded = !_menuExpanded)" />
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
                <BreadCrumbs ShowRoot="true" />
            </RadzenStack>
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="padding-right: 1rem;">
            <TeamSelector />
            <LoginDisplay />
        </RadzenStack>
    </RadzenStack>
</RadzenHeader>

<RadzenSidebar Responsive="false" Style="width: max-content">
    <RadzenPanelMenu DisplayStyle="@(_menuExpanded ? MenuItemDisplayStyle.IconAndText : MenuItemDisplayStyle.Icon)" ShowArrow="false">
        <RadzenPanelMenuItem Text="Home" Icon="home" Path="/" />
//-#if (IncludeSamples)
        <RadzenPanelMenuItem Text="Counter" Icon="exposure_plus_1" Path="/counter" />
        <RadzenPanelMenuItem Text="Weather" Icon="weather_mix" Path="/weather" />
//-#endif
        <AuthorizeView>
            <Authorized Context="authContext">
                <RadzenPanelMenuItem Text="Teams" Icon="groups" Path="/teams" />
                <RadzenPanelMenuItem Text="API Keys" Icon="vpn_key" Path="/api-keys" />
                <AuthorizeView Roles="@Roles.Developer" Context="devContext">
                    <Authorized Context="devAuthContext">
                        <RadzenPanelMenuItem Text="Users" Icon="people" Path="/users" />
                        <RadzenPanelMenuItem Text="Audit Log" Icon="history" Path="/audit" />
                    </Authorized>
                </AuthorizeView>
            </Authorized>
        </AuthorizeView>
        <RadzenPanelMenuItem Text="About" Icon="info" Path="/about" />
    </RadzenPanelMenu>
</RadzenSidebar>

@code {
    bool _menuExpanded = true;
}
