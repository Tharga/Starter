@using Tharga.Blazor1.Features.Audit
@inject ILocalStorageService LocalStorageService
@inject IHttpContextAccessor HttpContextAccessor

<RadzenHeader>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Stretch" JustifyContent="JustifyContent.SpaceBetween" Gap="0">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
            <RadzenSidebarToggle Click="@ToggleMenuExpanded" />
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
                <BreadCrumbs ShowRoot="true" />
            </RadzenStack>
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
//-#if (IncludeQuilt4Net)
            <LanguageSelector />
//-#endif
            <TeamSelector />
            <LoginDisplay />
        </RadzenStack>
    </RadzenStack>
</RadzenHeader>

<RadzenSidebar Responsive="false" Style="width: max-content">
    <RadzenPanelMenu DisplayStyle="@(_menuExpanded ? MenuItemDisplayStyle.IconAndText : MenuItemDisplayStyle.Icon)" ShowArrow="false">
        <RadzenPanelMenuItem Text="Home" Icon="home" Path="/" />
//-#if (IncludeSamples)
        <RadzenPanelMenuItem Text="Counter" Icon="exposure_plus_1" Path="/counter" />
        <RadzenPanelMenuItem Text="Weather" Icon="weather_mix" Path="/weather" />
//-#endif

        <AuthorizeView Roles="@Roles.TeamMember">
            <Authorized Context="teamContext">
                @if (_canManageApiKeys)
                {
                    <RadzenPanelMenuItem Text="Api" Icon="api">
                        <RadzenPanelMenuItem Text="API Keys" Icon="vpn_key" Path="/api-keys" />
                        <RadzenPanelMenuItem Text="Swagger" Icon="api" Path="/swagger" Target="WebApi" />
                        <RadzenPanelMenuItem Text="OpenApi" Icon="file_json" Path="/openapi/v1.json" Target="_blank" />
                    </RadzenPanelMenuItem>
                }
                @if (_canViewAudit)
                {
                    <RadzenPanelMenuItem Text="Audit" Icon="history" Path="/audit" />
                }
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="@Roles.Developer">
            <Authorized Context="devContext">
                <RadzenPanelMenuItem Text="Developer" Icon="logo_dev">
                    <RadzenPanelMenuItem Text="Database" Icon="database" Path="/developer/database" />
                    <RadzenPanelMenuItem Text="Users" Icon="person" Path="/developer/user" />
//-#if (IncludeCache)
                    <RadzenPanelMenuItem Text="Cache" Icon="cached" Path="/developer/cache" />
//-#endif
//-#if (IncludeQuilt4Net)
                    <RadzenPanelMenuItem Text="Log" Icon="view_object_track" Path="/developer/log" />
                    <RadzenPanelMenuItem Text="Content" Icon="book_2" Path="/developer/content" />
                    <RadzenPanelMenuItem Text="Configuration" Icon="settings_applications" Path="/developer/configuration" />
//-#endif
                    <RadzenPanelMenuItem Text="Audit" Icon="history" Path="/developer/audit" />
                </RadzenPanelMenuItem>
            </Authorized>
        </AuthorizeView>

        <RadzenPanelMenuItem Text="About" Icon="info" Path="/about" />
    </RadzenPanelMenu>
</RadzenSidebar>

@code {
    bool _menuExpanded = true;
    bool _canViewAudit;
    bool _canManageApiKeys;

    protected override async Task OnInitializedAsync()
    {
        _menuExpanded = await LocalStorageService.GetItemAsync<bool?>("MenuExpanded") ?? true;

        var user = HttpContextAccessor.HttpContext?.User;
        _canViewAudit = user?.HasClaim(TeamClaimTypes.Scope, AuditScopes.Read) == true
                     || user?.HasClaim(TeamClaimTypes.Scope, AuditScopes.ApiKeyUsage) == true;
        _canManageApiKeys = user?.HasClaim(TeamClaimTypes.Scope, ApiKeyScopes.Manage) == true;

        await base.OnInitializedAsync();
    }

    private async Task ToggleMenuExpanded(EventArgs arg)
    {
        _menuExpanded = !_menuExpanded;
        await LocalStorageService.SetItemAsync<bool?>("MenuExpanded", _menuExpanded);
    }
}
