@page "/developer/log/summary/{Fingerprint}"
@using Quilt4Net.Toolkit.Blazor.Features.Log
@attribute [Authorize(Roles = Roles.Developer)]
@inject BreadCrumbService BreadCrumbService

<LogSummaryView Fingerprint="@Fingerprint" Params="@P" DetailPath="/developer/log/detail" />

@code {
    [Parameter]
    public string Fingerprint { get; set; }

    [Parameter, SupplyParameterFromQuery]
    public string P { get; set; }

    protected override Task OnInitializedAsync()
    {
        BreadCrumbService.UnlinkSegment("developer");
        BreadCrumbService.UnlinkSegment("log");
        BreadCrumbService.RelinkSegment("summary", "/developer/log?tab=summary");

        return base.OnInitializedAsync();
    }
}
