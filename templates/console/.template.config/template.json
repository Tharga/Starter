{
  "$schema": "http://json.schemastore.org/template",
  "author": "Tharga",
  "classifications": ["Console", "Tharga"],
  "identity": "Tharga.Console",
  "name": "Tharga Console Application",
  "shortName": "tharga-console",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "Tharga.Console1",
  "preferNameDirectory": true,
  "symbols": {
    "IncludeSample": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Include sample command code"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            "**/bin/**",
            "**/obj/**",
            "**/.vs/**"
          ]
        },
        {
          "condition": "(!IncludeSample)",
          "exclude": [
            "**/Commands/**"
          ]
        }
      ]
    }
  ]
}
