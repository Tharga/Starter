<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tharga.Blazor" Version="2.1.2" />
    <!--#if (IncludeHealth) -->
    <PackageReference Include="Quilt4Net.Toolkit.Health" Version="0.6.9" />
    <!--#endif -->
    <ProjectReference Include="..\Tharga.Blazor1.Client\Tharga.Blazor1.Client.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.5" />
  </ItemGroup>

  <Target Name="RemoveClientRuntimeConfig" AfterTargets="Publish">
    <Delete Files="$(PublishDir)Tharga.Blazor1.Client.runtimeconfig.json" />
  </Target>

</Project>
